# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GITHUB
GITHUB_TOKEN=
GITHUB_REPO=

# --- Email (Resend) ---
# API key de Resend (resend.com/api-keys). Sin ella, las notificaciones se omiten en silencio.
RESEND_API_KEY=
# Remitente. Modo pruebas: "Nombre <onboarding@resend.dev>".
# Producción: usa un dominio verificado, ej. "DYMMSA Cotizaciones <notifications@tu-dominio.com>".
RESEND_FROM_EMAIL="DYMMSA Cotizaciones <onboarding@resend.dev>"
# Destinatario de los avisos de aprobación (el buzón de los empleados DYMMSA).
# En modo pruebas de Resend DEBE ser el correo de tu propia cuenta Resend.
NOTIFICATION_EMAIL_TO=
# Opcional: a dónde van las respuestas si alguien contesta el aviso.
NOTIFICATION_REPLY_TO=
# URL base de la app para el link "Ver cotización" en el correo.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- MCP remoto (OAuth 2.1 de Supabase, ADR-023) ---
# Allowlist de Client IDs OAuth (CSV) — Supabase → Authentication → OAuth Apps.
# Vacío = acepta cualquier cliente registrado en el proyecto.
MCP_OAUTH_CLIENT_IDS=
# Opcional: origen público de la app (SOLO el origen, sin ruta). Si falta, se
# deriva de VERCEL_PROJECT_PRODUCTION_URL; en local cae a http://localhost:3000.
# APP_URL=https://dymmsa-web.vercel.app

# --- Odoo (bloque del MCP, ADR-025) — opcional: sin esto las tools odoo_* avisan ---
# SOLO el origen, ej. https://<empresa>.odoo.com
ODOO_URL=
# Llave de LECTURA (API key con expiración: rotarla antes de que venza).
ODOO_API_KEY=
# Opcional (Odoo Online: una sola base).
ODOO_DB=
# Llave de ESCRITURA acotada (#144, ADR-040): cotizaciones, productos y facturas en BORRADOR.
# Sin ella el asistente no escribe en Odoo (no cae a ODOO_API_KEY). En Vercel va SOLO en
# Production y por ventanas: se agrega al usarla y se quita al terminar, con redeploy. Nunca en Preview.
# ODOO_WRITE_API_KEY=
